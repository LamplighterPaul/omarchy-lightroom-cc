#!/usr/bin/env python3
"""A local, inspectable Lightroom CC compatibility experiment for Omarchy."""
import argparse
import datetime
import hashlib
import io
import json
import lzma
import os
import re
import shlex
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
import tomllib
import zipfile

APP = "omarchy-lightroom-cc"
DATA = Path(os.environ.get("LRCC_DATA", Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / APP)).expanduser().resolve()
PREFIX = DATA / "prefix"
RUNTIME = DATA / "runtimes/wine-adobe-11.10"
PROTON = False
GRAPHICS = "x11"
RUNNER = "adobe"
WORKSPACE = 10  # Omarchy's Super+0.
TOOLS = DATA / "tools/usr/bin"
SCRIPT = Path(__file__).resolve()
MANIFEST = next((p for p in (SCRIPT.parent.parent / "manifest.json",
    SCRIPT.parent.parent / "share" / APP / "manifest.json") if p.is_file()), None)
LR = PREFIX / "drive_c/Program Files/Adobe/Adobe Lightroom CC/lightroom.exe"
CC = PREFIX / "drive_c/Program Files/Adobe/Adobe Creative Cloud/ACC/Creative Cloud.exe"


def run(args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def digest(path):
    with path.open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def manifest():
    if MANIFEST is None:
        raise RuntimeError("manifest.json missing; run from the checkout or use make install")
    return json.loads(MANIFEST.read_text())


def fetch(name):
    spec = manifest()[name]
    dest = DATA / "cache" / spec["filename"]
    dest.parent.mkdir(parents=True, exist_ok=True)
    if not dest.exists() or digest(dest) != spec["sha256"]:
        partial = dest.with_name(dest.name + ".partial")
        request = ["curl", "--fail", "--location", "--retry", "2", "--connect-timeout", "20",
                   "--max-time", "600", "--output", partial]
        if spec.get("user_agent"):
            request += ["--user-agent", spec["user_agent"]]
        run([*request, spec["url"]])
        if digest(partial) != spec["sha256"]:
            raise RuntimeError(f"Checksum mismatch for {name}; download retained at {partial}")
        partial.replace(dest)
    print(f"Verified {name}: {spec['sha256']}", flush=True)
    return dest


def bootstrap():
    archive = fetch("wine")
    if not (RUNTIME / "bin/wine").exists():
        RUNTIME.mkdir(parents=True, exist_ok=True)
        with tarfile.open(archive) as t:
            t.extractall(RUNTIME, filter="data")
    for name in ("cabextract", "winetricks"):
        package = fetch(name)
        (DATA / "tools").mkdir(exist_ok=True)
        run(["bsdtar", "-xf", package, "-C", DATA / "tools", f"usr/bin/{name}"])


def environment():
    if not (RUNTIME / "bin/wine").is_file():
        raise RuntimeError("Runtime missing. Run: omarchy-lightroom-cc fetch")
    env = os.environ.copy()
    env.update(WINEPREFIX=str(PREFIX), WINEARCH="win64", WINE=str(RUNTIME / "bin/wine"),
               WINESERVER=str(RUNTIME / "bin/wineserver"),
               PATH=f"{RUNTIME / 'bin'}:{TOOLS}:{env.get('PATH', '')}",
               DXVK_CONFIG_FILE=str(DATA / "dxvk.conf"),
               WINEDEBUG=env.get("LRCC_WINEDEBUG", "-all,err+all"))
    if PROTON:
        env.update(PROTONPATH=str(RUNTIME.parent), GAMEID="umu-default",
                   PROTON_LOG="1" if "LRCC_WINEDEBUG" in env else "0", PROTON_LOG_DIR=str(DATA / "logs"),
                   PROTON_USE_XALIA="0",
                   UMU_LOG="info", PROTONFIXES_DISABLE="1",
                   PROTON_ENABLE_WAYLAND="1" if GRAPHICS == "wayland" else "0")
        if RUNNER == "lightroom-omarchy-proton":
            profile = json.loads((PREFIX.parent / "profile.json").read_text())
            env.update(LIGHTROOM_OMARCHY_USERNAME=profile["windows_username"],
                       LIGHTROOM_OMARCHY_CENTER_MENUS="1", GAMEID="umu-lightroomomarchyproton")
            # Use this Proton build's replacements, including in migrated prefixes
            # that previously selected standalone native component experiments.
            env["WINEDLLOVERRIDES"] = env.get("WINEDLLOVERRIDES", "") + ";shcore,d2d1=b"
    if env.get("LRCC_PERF") == "1":
        layers = DATA / "tools/mangohud/layers"
        if (layers / "MangoHud.x86_64.json").is_file():
            output = DATA / "measurements/mangohud"
            output.mkdir(parents=True, exist_ok=True)
            env.update(MANGOHUD="1", VK_ADD_IMPLICIT_LAYER_PATH=str(layers),
                       MANGOHUD_CONFIGFILE=str(DATA / "performance.conf"))
        else:
            env["DXVK_HUD"] = "fps,frametimes,memory,gpuload,compiler,scale=2"
    return env


def stage_mangohud():
    """Install a pinned, application-local Vulkan overlay, without system changes."""
    archive = fetch("mangohud")
    root = DATA / "tools/mangohud"
    root.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="lrcc-hud-") as temporary:
        with tarfile.open(archive) as package:
            package.extractall(temporary, filter="data")
        with tarfile.open(Path(temporary) / "MangoHud/MangoHud-package.tar") as package:
            package.extractall(root, filter="data")
    layers = root / "layers"
    layers.mkdir(exist_ok=True)
    # Lightroom is 64-bit; scope discovery to this launcher and architecture.
    source = root / "usr/share/vulkan/implicit_layer.d/MangoHud.x86_64.json"
    layer = json.loads(source.read_text())
    layer["layer"]["library_path"] = str(root / "usr/lib/mangohud/lib64/libMangoHud.so")
    (layers / source.name).write_text(json.dumps(layer, indent=2) + "\n")
    output = DATA / "measurements/mangohud"
    output.mkdir(parents=True, exist_ok=True)
    config = DATA / "performance.conf"
    if not config.exists():
        config.write_text("fps\nframetime\nframe_timing\ncpu_stats\ngpu_stats\nram\nvram\n"
                          "font_size=28\nposition=top-left\nlog_interval=0\nlog_duration=60\n"
                          "toggle_logging=Shift_L+F2\npermit_upload=0\ncontrol=lightroom-perf-%p\n"
                          f"output_folder={output}\n")
    print("MangoHud staged. Run lightroom-omarchy-proton run-perf; Shift+F2 records 60 seconds.")


def wine(*args, **kwargs):
    command = DATA / "tools/umu/umu-run" if PROTON else RUNTIME / "bin/wine"
    env = environment()
    if PROTON and Path(str(args[0])).name.lower() != "lightroom.exe":
        env.update(PROTON_VERB="runinprefix", PROTON_LOG="0")
    return run([command, *args], env=env, **kwargs)


def stage_proton():
    for name, directory in (("proton-ge", DATA / "runtimes"), ("umu", DATA / "tools")):
        archive = fetch(name)
        directory.mkdir(parents=True, exist_ok=True)
        with tarfile.open(archive) as package:
            package.extractall(directory, filter="data")
    destination = DATA / "experiments/proton-ge/prefix"
    if not destination.exists():
        destination.parent.mkdir(parents=True, exist_ok=True)
        run(["cp", "-a", "--reflink=auto", DATA / "prefix", destination])
    print("Proton GE and UMU staged with a separate prefix copy.")


def stage_adobe_browser():
    """Stage Adobe's own Chromium browser and sign-in helper only."""
    archive = fetch("creative-cloud")
    common = PREFIX / "drive_c/Program Files/Common Files/Adobe/Adobe Desktop Common"
    with zipfile.ZipFile(archive) as outer:
        for component, folder in (("CEF64", "CEF"), ("NGL", "NGL")):
            target = common / folder
            with zipfile.ZipFile(io.BytesIO(outer.read(f"packages/ADC64/{component}/{component}.pima"))) as package:
                for member in package.infolist():
                    name = member.filename.replace("\\", "/")
                    relative = Path(name)
                    if relative.is_absolute() or ".." in relative.parts or ":" in name:
                        raise RuntimeError("Unsafe Adobe browser archive path")
                    dest = target / relative
                    if member.is_dir():
                        dest.mkdir(parents=True, exist_ok=True)
                    else:
                        dest.parent.mkdir(parents=True, exist_ok=True)
                        with package.open(member) as source, dest.open("wb") as out:
                            shutil.copyfileobj(source, out)
            print(f"Staged Adobe {component}: {target}")


def stage_staging():
    archive = fetch("wine-staging")
    runtime = DATA / "runtimes/wine-staging-11.17"
    if not (runtime / "usr/bin/wine").is_file():
        runtime.mkdir(parents=True, exist_ok=True)
        run(["bsdtar", "-xf", archive, "-C", runtime, "usr"])
    destination = DATA / "experiments/wine-staging-11.17/prefix"
    if not destination.exists():
        destination.parent.mkdir(parents=True, exist_ok=True)
        run(["cp", "-a", "--reflink=auto", DATA / "prefix", destination])
    print("Wine Staging 11.17 staged with a separate prefix copy.")


def logged(label, action):
    logs = DATA / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    path = logs / f"{stamp}-{label}.log"
    print(f"Log: {path}", flush=True)
    with path.open("w") as log:
        action(log)


def prepare():
    bootstrap()
    DATA.mkdir(parents=True, exist_ok=True)
    (DATA / "dxvk.conf").write_text("dxgi.enableDummyCompositionSwapchain = True\n")
    PREFIX.mkdir(exist_ok=True)
    (DATA / "prepared.json").unlink(missing_ok=True)
    def steps(log):
        if not (PREFIX / "system.reg").is_file():
            env = environment()
            env["WINEDLLOVERRIDES"] = "mscoree,mshtml="
            run([RUNTIME / "bin/wine", "wineboot", "--init"], env=env, stdout=log, stderr=log)
            run([RUNTIME / "bin/wineserver", "-w"], env=env, stdout=log, stderr=log)
        # Xwayland is the baseline in the successful Arch/Intel report.
        wine("reg", "add", r"HKCU\Software\Wine\Drivers", "/v", "Graphics", "/d", "x11", "/f", stdout=log, stderr=log)
        # Keep each completed dependency recorded so failed installs can resume.
        for verb in ("corefonts", "msxml6", "gdiplus", "atmlib", "dxvk"):
            marker = DATA / f".prepared-{verb}"
            if not marker.exists():
                print(f"Preparing {verb}…", flush=True)
                run([TOOLS / "winetricks", "-q", verb], env=environment(), stdout=log, stderr=log)
                marker.touch()
        run([TOOLS / "winetricks", "-q", "win11"], env=environment(), stdout=log, stderr=log)
    logged("prepare", steps)
    repair_vcrun()
    repair_browser()
    (DATA / "prepared.json").write_text(json.dumps({"runtime_sha256": manifest()["wine"]["sha256"],
        "status": "dependencies prepared; Adobe not verified"}, indent=2) + "\n")


def repair_vcrun():
    """Upgrade Microsoft's redistributables, including Wine's version-number workaround."""
    if not (PREFIX / "system.reg").exists():
        raise RuntimeError("Run prepare first")
    packages = {arch: fetch("vcrun-" + arch) for arch in ("x86", "x64")}
    def steps(log):
        for arch, cabinet, directory in (("x86", "a10", "syswow64"), ("x64", "a12", "system32")):
            with tempfile.TemporaryDirectory(prefix="vcrun-", dir=DATA) as temp:
                run([TOOLS / "cabextract", "-q", "-d", temp, "-F", cabinet, packages[arch]], stdout=log, stderr=log)
                # Microsoft's installer can leave Wine's higher-version builtin behind.
                run([TOOLS / "cabextract", "-q", "-d", PREFIX / "drive_c/windows" / directory,
                     "-F", "msvcp140.dll", Path(temp) / cabinet], stdout=log, stderr=log)
            result = subprocess.run([str(RUNTIME / "bin/wine"), str(packages[arch]),
                "/install", "/quiet", "/norestart"], env=environment(), stdout=log, stderr=log)
            if result.returncode not in (0, 194):  # Windows 3010 (reboot requested), truncated to 8 bits.
                raise RuntimeError(f"Microsoft {arch} runtime installer exited {result.returncode}")
        for name in ("concrt140", "msvcp140", "msvcp140_1", "msvcp140_2", "msvcp140_atomic_wait",
                     "msvcp140_codecvt_ids", "vcamp140", "vccorlib140", "vcomp140", "vcruntime140", "vcruntime140_1"):
            wine("reg", "add", r"HKCU\Software\Wine\DllOverrides", "/v", name, "/d", "native,builtin",
                 "/f", stdout=log, stderr=log)
        (DATA / ".prepared-vcrun2022").touch()
    logged("repair-vcrun", steps)


def repair_browser():
    if not (PREFIX / "system.reg").exists():
        raise RuntimeError("Run prepare first")
    archive = fetch("gecko")
    run(["bsdtar", "-xf", archive, "-C", DATA / "tools", "usr/share/wine/gecko"])
    gecko = DATA / "tools/usr/share/wine/gecko"
    dest = RUNTIME / "share/wine/gecko"
    dest.parent.mkdir(parents=True, exist_ok=True)
    if not dest.exists():
        dest.symlink_to(gecko, target_is_directory=True)
    def steps(log):
        for arch, key in (("x86_64", r"HKLM\Software\Wine\MSHTML\2.47.4"),
                          ("x86", r"HKLM\Software\Wow6432Node\Wine\MSHTML\2.47.4")):
            path = gecko / f"wine-gecko-2.47.4-{arch}"
            windows_path = "Z:" + str(path).replace("/", "\\") + "\\"
            wine("reg", "add", key, "/v", "GeckoPath", "/d", windows_path, "/f", stdout=log, stderr=log)
        wine("regsvr32", "/s", "mshtml.dll", stdout=log, stderr=log)
        wine(r"C:\windows\syswow64\regsvr32.exe", "/s", "mshtml.dll", stdout=log, stderr=log)
    logged("repair-browser", steps)


def repair_webview():
    installer = fetch("webview2")
    logged("repair-webview", lambda log: wine(installer, "/silent", "/install", stdout=log, stderr=log))
    candidates = list(PREFIX.glob("drive_c/Program Files*/Microsoft/EdgeWebView/Application/*/msedgewebview2.exe"))
    if not candidates:
        raise RuntimeError("WebView2 installer completed without creating its runtime")
    for path in candidates:
        print(f"WebView2 runtime: {path.parent.name}")


def repair_webview_rendering(profile="software"):
    # This Adobe build ignored the equivalent environment variable; verify
    # the browser's actual Windows command line after changing the policy.
    profiles = {"software": "--disable-gpu --disable-gpu-compositing",
                "in-process": "--disable-gpu --disable-gpu-compositing --in-process-gpu",
                "swiftshader": "--use-angle=swiftshader",
                "no-sandbox-test": "--disable-gpu --disable-gpu-compositing --no-sandbox",
                "no-sandbox-diagnostic": "--disable-gpu --disable-gpu-compositing --no-sandbox --remote-debugging-address=127.0.0.1 --remote-debugging-port=19223 --enable-logging=stderr",
                "native-diagnostic": "--remote-debugging-address=127.0.0.1 --remote-debugging-port=19223 --enable-logging=stderr",
                "gpu-sandbox": "--disable-gpu --disable-gpu-compositing --disable-gpu-sandbox",
                "diagnostic": "--disable-gpu --disable-gpu-compositing --in-process-gpu --remote-debugging-address=127.0.0.1 --remote-debugging-port=19223 --enable-logging=stderr"}
    if profile not in profiles:
        raise RuntimeError(f"Unknown rendering policy: {profile}")
    arguments = profiles[profile]
    entries = [(r"HKEY_CURRENT_USER\Software\Policies\Microsoft\Edge\WebView2\AdditionalBrowserArguments", "lightroom.exe")]
    for root in ("HKEY_CURRENT_USER", "HKEY_LOCAL_MACHINE"):
        entries.extend(((root + r"\Software\Policies\Microsoft\Edge\WebView2\AdditionalBrowserArguments", "*"),
                        (root + r"\Software\Policies\Microsoft\EmbeddedBrowserWebView\LoaderOverride\*", "additionalBrowserArguments")))
    with tempfile.TemporaryDirectory(prefix="webview-policy-", dir=DATA) as temp:
        policy = Path(temp) / "rendering.reg"
        policy.write_text("Windows Registry Editor Version 5.00\n\n" + "\n".join(
            f'[{key}]\n"{value}"="{arguments}"\n' for key, value in entries), encoding="utf-16")
        logged("webview-policy", lambda log: wine("reg.exe", "import", "Z:" + str(policy).replace("/", "\\"), stdout=log, stderr=log))
    print(f"Set WebView2 policy in the Lightroom prefix: {arguments}. Restart Lightroom to test.")


def repair_dxvk():
    archive = fetch("dxvk")
    run([RUNTIME / "bin/wineserver", "-k"], env=environment())
    with tempfile.TemporaryDirectory(prefix="dxvk-", dir=DATA) as temp:
        with tarfile.open(archive) as package:
            package.extractall(temp, filter="data")
        for arch, directory in (("x64", "system32"), ("x32", "syswow64")):
            for name in ("d3d11.dll", "dxgi.dll"):
                dest = PREFIX / "drive_c/windows" / directory / name
                backup = DATA / "patches/dxvk-original" / directory / name
                backup.parent.mkdir(parents=True, exist_ok=True)
                if not backup.exists():
                    shutil.copy2(dest, backup)
                replacement = dest.with_suffix(".dll.new")
                shutil.copy2(Path(temp) / "dxvk-2.7.1" / arch / name, replacement)
                replacement.replace(dest)
    for name in ("d3d11", "dxgi"):
        wine("reg", "add", r"HKCU\Software\Wine\DllOverrides", "/v", name, "/d", "native", "/f")
    print("Installed pinned DXVK 2.7.1 for the graphics comparison.")


def stage_webview148():
    archive = fetch("webview2-148")
    package = fetch("7zip")
    run(["bsdtar", "-xf", package, "-C", DATA / "tools", "usr"])
    extractor = DATA / "tools/usr/lib/7zip/7z"
    staging = DATA / "installers/webview148"
    target = DATA / "runtimes/webview148"
    browser = target / "Chrome-bin/148.0.3967.70"
    if not (browser / "msedgewebview2.exe").is_file():
        run([extractor, "x", "-y", "-bso0", "-bsp0", f"-o{staging}", archive, "MicrosoftEdge_X64_148.0.3967.70.exe.*"])
        candidates = list(staging.glob("MicrosoftEdge_X64_148.0.3967.70.exe.*"))
        if len(candidates) != 1:
            raise RuntimeError("Unexpected archived WebView2 payload")
        run([extractor, "x", "-y", "-bso0", "-bsp0", f"-o{staging}", candidates[0]])
        run([extractor, "x", "-y", "-bso0", "-bsp0", f"-o{target}", staging / "MSEDGE.7z"])
    select_webview("Z:" + str(browser).replace("/", "\\"))


def select_webview(folder=""):
    for root in ("HKCU", "HKLM"):
        wine("reg", "add", root + r"\Software\Policies\Microsoft\Edge\WebView2\BrowserExecutableFolder",
             "/v", "*", "/d", folder, "/f")
        wine("reg", "add", root + r"\Software\Policies\Microsoft\EmbeddedBrowserWebView\LoaderOverride\*",
             "/v", "browserExecutableFolder", "/d", folder, "/f")
    print(f"WebView2 selection: {folder or 'installed runtime'}. Restart Lightroom to test.")


def install_cc(path=None):
    if not (DATA / "prepared.json").exists():
        raise RuntimeError("Run prepare first")
    if path:
        exe = Path(path).expanduser().resolve()
        if not exe.is_file():
            raise RuntimeError(f"Installer not found: {exe}")
    else:
        archive = fetch("creative-cloud")
        dest = DATA / "installers/creative-cloud-6.10.0"
        dest.mkdir(parents=True, exist_ok=True)
        run(["unzip", "-q", "-o", archive, "-d", dest])
        candidates = list(dest.rglob("Set-up.exe"))
        if len(candidates) != 1:
            raise RuntimeError(f"Expected one Set-up.exe, found {len(candidates)}")
        exe = candidates[0]
    print("Complete Adobe sign-in in the installer window.", flush=True)
    env = environment()
    env["WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS"] = "--disable-gpu"
    logged("install-cc", lambda log: run([RUNTIME / "bin/wine", exe], cwd=exe.parent,
        env=env, stdout=log, stderr=log))


def extract_lightroom(archive, target):
    """Map Adobe's Windows ZIP payload to an app directory, rejecting traversal."""
    with zipfile.ZipFile(archive) as z:
        for entry in z.infolist():
            name = entry.filename.replace("\\", "/")
            if not name.startswith("1/Adobe Lightroom/"):
                continue
            relative = name.removeprefix("1/Adobe Lightroom/")
            if not relative:
                continue
            parts = relative.split("/")
            if any(p in ("..", ".") or ":" in p for p in parts) or relative.startswith("/"):
                raise RuntimeError(f"Unsafe archive path: {name}")
            out = target / relative
            if not out.resolve().is_relative_to(target.resolve()):
                raise RuntimeError(f"Archive path escapes app directory: {name}")
            if name.endswith("/"):
                out.mkdir(parents=True, exist_ok=True)
            else:
                out.parent.mkdir(parents=True, exist_ok=True)
                with z.open(entry) as source, out.open("wb") as dest:
                    decode_adobe_file(source, dest)


def decode_adobe_file(source, destination):
    """Adobe HD ZIP entries: one LZMA2 dictionary-property byte, then raw LZMA2."""
    first = source.read(1)
    if not first:
        return
    prop = first[0]
    # The pinned package uses a 16 MiB dictionary. Bound allocation on malformed data.
    if prop > 30:
        raise RuntimeError(f"Unsupported Adobe LZMA2 dictionary property: {prop}")
    dictionary_size = (2 | (prop & 1)) << (prop // 2 + 11)
    with lzma.LZMAFile(source, "rb", format=lzma.FORMAT_RAW,
                      filters=[{"id": lzma.FILTER_LZMA2, "dict_size": dictionary_size}]) as decoded:
        shutil.copyfileobj(decoded, destination, length=1024 * 1024)


def stage_lightroom():
    if not (DATA / "prepared.json").exists():
        raise RuntimeError("Run prepare first")
    if LR.exists():
        raise RuntimeError("Lightroom already exists; refusing to overwrite an installation")
    archive = fetch("lightroom")
    print("Extracting the unmodified Adobe app payload (experimental direct route)…", flush=True)
    LR.parent.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".lightroom-stage-", dir=LR.parent.parent) as temp:
        target = Path(temp) / "Adobe Lightroom CC"
        extract_lightroom(archive, target)
        with (target / "lightroom.exe").open("rb") as exe:
            if exe.read(2) != b"MZ":
                raise RuntimeError("Archive did not produce a Windows executable")
        if LR.parent.exists():
            raise RuntimeError(f"Destination already exists: {LR.parent}")
        target.rename(LR.parent)
    (DATA / "lightroom-staged.json").write_text(json.dumps({
        "version": manifest()["lightroom"]["version"], "sha256": digest(archive),
        "method": "direct Adobe ZIP with LZMA2 decoding; installer registration not performed",
        "verified": False}, indent=2) + "\n")
    print("Payload staged. Run 'omarchy-lightroom-cc run' to test startup and Adobe sign-in.")


def experiment_d2d():
    replacement = DATA / "patches/d2d1.dll"
    metadata = json.loads(replacement.with_suffix(".json").read_text())
    if digest(replacement) != metadata["dll_sha256"]:
        raise RuntimeError("Built Direct2D component checksum mismatch")
    dest = PREFIX / "drive_c/windows/system32/d2d1.dll"
    backup = DATA / "patches/d2d1-original.dll"
    run([RUNTIME / "bin/wineserver", "-k"], env=environment())
    if not backup.exists():
        shutil.copy2(dest, backup)
    temporary = dest.with_suffix(".dll.new")
    shutil.copy2(replacement, temporary)
    temporary.replace(dest)
    wine("reg", "add", r"HKCU\Software\Wine\DllOverrides", "/v", "d2d1", "/d", "native", "/f")
    print("Installed experimental Direct2D pass-through. Color accuracy remains unverified.")


def restore_d2d():
    backup = DATA / "patches/d2d1-original.dll"
    if not backup.is_file():
        raise RuntimeError("No original Direct2D backup exists")
    run([RUNTIME / "bin/wineserver", "-k"], env=environment())
    dest = PREFIX / "drive_c/windows/system32/d2d1.dll"
    temporary = dest.with_suffix(".dll.new")
    shutil.copy2(backup, temporary)
    temporary.replace(dest)
    wine("reg", "add", r"HKCU\Software\Wine\DllOverrides", "/v", "d2d1", "/d", "builtin", "/f")
    print("Restored the original Wine Direct2D component.")


def launch(exe, label, args):
    if not exe.is_file():
        raise RuntimeError(f"{label} is not installed: {exe}")
    def start(log):
        sync_display_scale(log)
        if RUNNER == "lightroom-omarchy-proton":
            sync_theme(log)
        wine(exe, *args, cwd=exe.parent, stdout=log, stderr=log)
    logged(label, start)


def desktop_scale(monitors, workspaces):
    """Use the destination workspace's monitor, falling back to the focused one."""
    target = next((w.get("monitor") for w in workspaces if w.get("id") == WORKSPACE), None)
    monitor = next((m for m in monitors if m.get("name") == target), None)
    monitor = monitor or next((m for m in monitors if m.get("focused")), None)
    if not monitor:
        raise RuntimeError("Cannot determine Lightroom's target monitor scale")
    scale = float(monitor["scale"])
    if not 0.5 <= scale <= 4:
        raise RuntimeError(f"Invalid monitor scale: {scale}")
    return round(96 * scale)


def theme_registry(palette):
    """Only Windows chrome/system controls; Adobe paints its own photo interface."""
    def rgb(key):
        value = palette[key]
        if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
            raise ValueError(f"Invalid Omarchy theme colour: {key}")
        return " ".join(str(int(value[n:n+2], 16)) for n in (1, 3, 5))
    keys = {"Menu": "background", "MenuBar": "background", "MenuText": "foreground",
            "MenuHilight": "accent", "Hilight": "accent", "HilightText": "background",
            "ButtonFace": "background", "ButtonText": "foreground",
            "ButtonHilight": "lighter_background", "ButtonShadow": "dark_background",
            "GrayText": "dark_foreground", "Window": "background", "WindowText": "foreground"}
    lines = ["Windows Registry Editor Version 5.00", "", r"[HKEY_CURRENT_USER\Control Panel\Colors]"]
    lines += [f'"{name}"="{rgb(key)}"' for name, key in keys.items()]
    lines += ["", r"[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]",
              '"MenuHeight"="-420"', "",
              r"[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]",
              '"ThemeActive"="1"', ""]
    return "\r\n".join(lines)


def sync_theme(log):
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    colours = state / "omarchy/current/theme/colors.toml"
    if not colours.is_file():
        print("Omarchy palette unavailable; retaining current Windows menu colours.", flush=True)
        return
    registry = theme_registry(tomllib.loads(colours.read_text()))
    # Migrating standalone Wine can remove external-font registrations. Adobe's
    # DirectWrite layouts require Tahoma even though Proton already ships it.
    for name in ("tahoma.ttf", "tahomabd.ttf"):
        if not (RUNTIME / "share/wine/fonts" / name).is_file():
            raise RuntimeError(f"Proton is missing its bundled font: {name}")
    for key in (r"HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts",
                r"HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\Windows NT\CurrentVersion\Fonts"):
        registry += (f"\r\n[{key}]\r\n" + '"Tahoma (TrueType)"="tahoma.ttf"\r\n'
                     + '"Tahoma Bold (TrueType)"="tahomabd.ttf"\r\n')
    stamp = hashlib.sha256(registry.encode()).hexdigest()
    marker = PREFIX.parent / "theme.json"
    if marker.exists() and json.loads(marker.read_text()).get("sha256") == stamp:
        return
    backup = PREFIX.parent / "theme-backup"
    backup.mkdir(exist_ok=True)
    for label, key in (("colours", r"HKCU\Control Panel\Colors"),
                       ("metrics", r"HKCU\Control Panel\Desktop\WindowMetrics"),
                       ("theme", r"HKCU\Software\Microsoft\Windows\CurrentVersion\ThemeManager")):
        saved = backup / f"{label}.reg"
        if not saved.exists():
            wine("reg", "export", key, "Z:" + str(saved).replace("/", "\\"), "/y", stdout=log, stderr=log)
    path = PREFIX.parent / "omarchy-theme.reg"
    path.write_text(registry, encoding="utf-16")
    wine("reg", "import", "Z:" + str(path).replace("/", "\\"), stdout=log, stderr=log)
    marker.write_text(json.dumps({"sha256": stamp, "source": str(colours)}, indent=2) + "\n")
    print("Applied current Omarchy palette to Windows menus and dialogs.", flush=True)


def sync_display_scale(log):
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"], text=True))
    workspaces = json.loads(subprocess.check_output(["hyprctl", "workspaces", "-j"], text=True))
    dpi = desktop_scale(monitors, workspaces)
    # When Xwayland itself scales windows, Wine must not apply the scale twice.
    if GRAPHICS == "x11":
        option = json.loads(subprocess.check_output(
            ["hyprctl", "getoption", "xwayland:force_zero_scaling", "-j"], text=True))
        if not option.get("bool", option.get("int", False)):
            dpi = 96
    print(f"Desktop scale: {dpi / 96:g}x ({dpi} Wine DPI)", flush=True)
    wine("reg", "add", r"HKCU\Control Panel\Desktop", "/v", "LogPixels",
         "/t", "REG_DWORD", "/d", str(dpi), "/f", stdout=log, stderr=log)


def dispatch_desktop():
    """Preserve shell arguments and caller configuration across Hyprland's shell."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or os.environ.get("LRCC_DISPATCHED") == "1":
        return False
    variables = [f"{k}={v}" for k, v in os.environ.items()
                 if k.startswith("LRCC_") or k in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY")]
    command = shlex.join(["env", *variables, "LRCC_DISPATCHED=1", str(SCRIPT), *sys.argv[1:]])
    # json quoting is used for a Lua string, not shell escaping.
    expression = f'hl.dsp.exec_cmd({json.dumps(command, ensure_ascii=False)}, {{workspace="10 silent", no_initial_focus=true}})'
    result = subprocess.check_output(["hyprctl", "dispatch", expression], text=True)
    if result.strip() != "ok":
        raise RuntimeError(f"Hyprland rejected Lightroom launch: {result.strip()}")
    print("Launched on Super+0 (workspace 10), without switching focus.")
    return True


def stage_omarchy():
    archive = fetch("omarchy-proton")
    with tarfile.open(archive) as package:
        package.extractall(DATA / "runtimes", filter="data")
    destination = DATA / "experiments/omarchy-proton/prefix"
    source = DATA / "experiments/wine-staging-11.17/prefix"
    if not (source / "system.reg").exists():
        raise RuntimeError("A working staging prefix is required for the comparison")
    if not destination.exists():
        # Refuse to copy a live database/registry snapshot.
        for proc in Path("/proc").glob("[0-9]*/environ"):
            try:
                if f"WINEPREFIX={source}".encode() in proc.read_bytes().split(b"\0"):
                    raise RuntimeError("Close the staging runner before copying its prefix")
            except (PermissionError, ProcessLookupError, FileNotFoundError):
                pass
        destination.parent.mkdir(parents=True, exist_ok=True)
        run(["cp", "-a", "--reflink=auto", source, destination])
    print("Omarchy Proton candidate staged separately from the working installation.")


def repair_performance():
    """Install the validated component experiment in the selected, closed prefix."""
    if PROTON:
        raise RuntimeError("This component profile is for standalone Wine; use --runner staging")
    shcore = DATA / "patches/shcore.dll"
    metadata = json.loads(shcore.with_suffix(".json").read_text())
    if digest(shcore) != metadata["dll_sha256"]:
        raise RuntimeError("Monitor-scale DLL checksum mismatch; rebuild it first")
    archive = fetch("omarchy-proton")
    bundle = manifest()["omarchy-proton"]["filename"].removesuffix(".tar.gz")
    payload = {}
    with tarfile.open(archive) as package:
        for arch, directory in (("x86_64-windows", "system32"), ("i386-windows", "syswow64")):
            for component, names in (("dxvk", ("dxgi.dll", "d3d11.dll")),
                                     ("vkd3d-proton", ("d3d12.dll", "d3d12core.dll"))):
                for name in names:
                    member = package.getmember(f"{bundle}/files/lib/wine/{component}/{arch}/{name}")
                    if not member.isfile():
                        raise RuntimeError("Unexpected graphics payload")
                    payload[Path("drive_c/windows") / directory / name] = package.extractfile(member).read()
    payload[Path("drive_c/windows/system32/shcore.dll")] = shcore.read_bytes()
    for proc in Path("/proc").glob("[0-9]*"):
        try:
            if (f"WINEPREFIX={PREFIX}".encode() in (proc / "environ").read_bytes().split(b"\0")
                    and (proc / "comm").read_text().strip().lower() == "lightroom.exe"):
                raise RuntimeError("Close Lightroom normally before applying the performance profile")
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
    preferences = list(PREFIX.glob("drive_c/users/*/AppData/Roaming/Adobe/Lightroom CC/Preferences/Lightroom CC Preferences.agprefs"))
    preferences = list({p.resolve(): p for p in preferences}.values())
    if len(preferences) != 1:
        raise RuntimeError("Expected one Lightroom preferences file")
    prefs = preferences[0]
    text = prefs.read_text()
    for key, value in (("gpu4setting", '"custom"'), ("useGPUforComputeCB", "true"),
                       ("useGPUforDisplayCB", "true")):
        text, count = re.subn(r"(?m)^(\s*" + key + r"\s*=\s*)[^,]+,", r"\g<1>" + value + ",", text)
        if count != 1:
            raise RuntimeError(f"Missing or ambiguous preference: {key}")
    try:
        run([RUNTIME / "bin/wineserver", "-k"], env=environment())
    except subprocess.CalledProcessError as exc:
        if exc.returncode != 1:  # wineserver returns 1 when this prefix has no server.
            raise
    backup = DATA / "patches/performance-backups" / hashlib.sha256(str(PREFIX).encode()).hexdigest()[:16]
    backup.mkdir(parents=True, exist_ok=True, mode=0o700)
    for relative in [*payload, prefs.relative_to(PREFIX), Path("user.reg")]:
        target = PREFIX / relative
        original = backup / relative
        if target.exists() and not original.exists():
            original.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, original)
    for relative, content in payload.items():
        target = PREFIX / relative
        temporary = target.with_suffix(".dll.new")
        temporary.write_bytes(content)
        temporary.replace(target)
    prefs.write_text(text)
    wine("reg", "add", r"HKCU\Software\Wine\AppDefaults\lightroom.exe\DllOverrides",
         "/v", "shcore", "/d", "native,builtin", "/f")
    (backup / "profile.json").write_text(json.dumps({"prefix": str(PREFIX),
        "graphics": manifest()["omarchy-proton"], "scale": metadata,
        "gpu_image_processing": True, "interactive_performance_verified": False}, indent=2) + "\n")
    print(f"Installed graphics, DPI and GPU-processing profile. Originals: {backup}")


def repair_growth_sdk():
    """Disable optional GrowthSDK only for Lightroom in the selected prefix."""
    wine("reg", "add", r"HKCU\Software\Wine\AppDefaults\lightroom.exe\DllOverrides",
         "/v", "AdobeGrowthSDK", "/t", "REG_SZ", "/d", "", "/f")
    print("Disabled optional AdobeGrowthSDK for Lightroom. Restart Lightroom to apply.")


def repair_d3d12():
    """Install the pinned Proton bundle's vkd3d-proton into the selected prefix."""
    archive = fetch("proton-ge")
    bundle = manifest()["proton-ge"]["filename"].removesuffix(".tar.gz")
    names = ("d3d12.dll", "d3d12core.dll")
    members = {f"{bundle}/files/lib/wine/vkd3d-proton/x86_64-windows/{name}": name
               for name in names}
    with tempfile.TemporaryDirectory(prefix="lrcc-d3d12-") as temporary:
        staged = Path(temporary)
        with tarfile.open(archive, "r|gz") as package:
            for member in package:
                if member.name not in members:
                    continue
                if not member.isfile():
                    raise RuntimeError("Expected a regular vkd3d-proton DLL in the pinned archive")
                with package.extractfile(member) as source, (staged / members[member.name]).open("wb") as out:
                    shutil.copyfileobj(source, out)
        if not all((staged / name).is_file() for name in names):
            raise RuntimeError("Pinned Proton archive is missing the vkd3d-proton DLL pair")
        try:
            run([RUNTIME / "bin/wineserver", "-k"], env=environment(), capture_output=True, text=True)
        except subprocess.CalledProcessError as exc:
            # Wine returns 1 with no output when this prefix has no running server.
            if exc.returncode != 1 or exc.stdout or exc.stderr:
                raise
        backup = PREFIX.parent / "repairs/d3d12"
        backup.mkdir(parents=True, exist_ok=True)
        for name in names:
            target = PREFIX / "drive_c/windows/system32" / name
            if target.exists() and not (backup / name).exists():
                shutil.copy2(target, backup / name)
            replacement = target.with_suffix(".dll.new")
            shutil.copy2(staged / name, replacement)
            replacement.replace(target)
            wine("reg", "add", r"HKCU\Software\Wine\AppDefaults\lightroom.exe\DllOverrides",
                 "/v", Path(name).stem, "/t", "REG_SZ", "/d", "native", "/f")
    print(f"Installed vkd3d-proton for Lightroom. Original DLLs retained in {backup}")


def debug(args):
    wine("winedbg", "--command", " ".join(args or ["info", "proc"]))


def browser_status():
    """Report rendering flags without exposing browser URLs or login arguments."""
    report = []
    for proc in Path("/proc").glob("[0-9]*"):
        try:
            command = (proc / "cmdline").read_bytes()
            if not any(name in command.lower() for name in (b"lightroom.exe", b"msedgewebview2.exe")):
                continue
            variables = dict(item.split(b"=", 1) for item in (proc / "environ").read_bytes().split(b"\0") if b"=" in item)
            if variables.get(b"WINEPREFIX") != str(PREFIX).encode():
                continue
            report.append({"pid": int(proc.name), "browser": b"msedgewebview2.exe" in command.lower(),
                "webview_flags": variables.get(b"WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS", b"").decode(errors="replace"),
                "flags_present": [flag for flag in ("--disable-gpu", "--no-sandbox", "--use-angle=swiftshader", "--in-process-gpu") if flag.encode() in command]})
        except (OSError, ValueError):
            continue
    print(json.dumps(report, indent=2))


def status():
    return {"data": str(DATA), "prefix": str(PREFIX), "runtime_present": (RUNTIME / "bin/wine").is_file(),
            "prefix_created": (PREFIX / "system.reg").is_file(),
            "dependencies_prepared": (DATA / "prepared.json").is_file(),
            "creative_cloud_exe_present": CC.is_file(), "lightroom_exe_present": LR.is_file(),
            "workflow_verified": False}


def doctor():
    result = status()
    result["host"] = os.uname()._asdict() if hasattr(os.uname(), "_asdict") else list(os.uname())
    result["tools"] = {x: shutil.which(x) for x in ("curl", "bsdtar", "unzip", "vulkaninfo")}
    result["display"] = {x: os.environ.get(x) for x in ("XDG_SESSION_TYPE", "DISPLAY", "WAYLAND_DISPLAY")}
    result["free_disk_gib"] = round(shutil.disk_usage(Path.home()).free / 1024**3, 1)
    print(json.dumps(result, indent=2))


def integrate():
    if not LR.is_file():
        raise RuntimeError("Install Lightroom before adding its desktop entry")
    dest = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "applications"
    dest.mkdir(parents=True, exist_ok=True)
    # The executable path in a desktop entry uses its own escaping rules.
    def quote(value):
        return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"').replace("`", "\\`").replace("$", "\\$").replace("%", "%%") + '"'
    name = "Lightroom (Omarchy Proton)" if RUNNER == "lightroom-omarchy-proton" else "Lightroom CC"
    (dest / f"{APP}.desktop").write_text(f'[Desktop Entry]\nType=Application\nName={name}\n'
        f'Comment=Adobe Lightroom CC on Omarchy\nExec=env {quote("LRCC_DATA=" + str(DATA))} {quote(SCRIPT)} --runner {RUNNER} --graphics {GRAPHICS} run\n'
        'Icon=camera-photo\nTerminal=false\nCategories=Graphics;Photography;\nStartupNotify=true\n')
    print(f"Installed {dest / (APP + '.desktop')}")


def main():
    global PREFIX, RUNTIME, LR, CC, PROTON, GRAPHICS, RUNNER
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runner", choices=("adobe", "staging", "proton", "omarchy", "lightroom-omarchy-proton"), default="adobe")
    parser.add_argument("--graphics", choices=("x11", "wayland"), default="x11")
    parser.add_argument("command", choices=("doctor", "status", "fetch", "prepare", "initialize-runner", "repair-vcrun", "repair-browser", "repair-webview", "repair-webview-rendering", "repair-dxvk", "repair-growth-sdk", "repair-d3d12", "repair-performance", "stage-webview-148", "stage-proton", "stage-staging", "stage-adobe-browser", "use-installed-webview", "stage-lightroom", "experiment-d2d", "restore-d2d", "experiment-webview", "browser-status", "capture-webview", "install-cc", "cc", "run", "run-debug", "native-debug", "debug", "ui", "stop", "integrate", "run-perf", "stage-mangohud", "measure"))
    parser.add_argument("args", nargs="*")
    args = parser.parse_args()
    if args.command in ("run", "run-perf", "run-debug", "cc", "install-cc", "experiment-webview") and dispatch_desktop():
        return
    GRAPHICS = args.graphics
    RUNNER = args.runner
    if args.runner == "staging":
        PREFIX = DATA / "experiments/wine-staging-11.17/prefix"
        RUNTIME = DATA / "runtimes/wine-staging-11.17/usr"
        LR = PREFIX / "drive_c/Program Files/Adobe/Adobe Lightroom CC/lightroom.exe"
        CC = PREFIX / "drive_c/Program Files/Adobe/Adobe Creative Cloud/ACC/Creative Cloud.exe"
    elif args.runner == "lightroom-omarchy-proton":
        PROTON = True
        PREFIX = DATA / "experiments/lightroom-omarchy-proton/prefix"
        RUNTIME = DATA / "runtimes/lightroom-omarchy-proton/files"
        LR = PREFIX / "drive_c/Program Files/Adobe/Adobe Lightroom CC/lightroom.exe"
        CC = PREFIX / "drive_c/Program Files/Adobe/Adobe Creative Cloud/ACC/Creative Cloud.exe"
    elif args.runner in ("proton", "omarchy"):
        PROTON = True
        PREFIX = DATA / ("experiments/omarchy-proton/prefix" if args.runner == "omarchy" else "experiments/proton-ge/prefix")
        bundle = manifest()["omarchy-proton" if args.runner == "omarchy" else "proton-ge"]["filename"].removesuffix(".tar.gz")
        RUNTIME = DATA / "runtimes" / bundle / "files"
        LR = PREFIX / "drive_c/Program Files/Adobe/Adobe Lightroom CC/lightroom.exe"
        CC = PREFIX / "drive_c/Program Files/Adobe/Adobe Creative Cloud/ACC/Creative Cloud.exe"
    if os.environ.get("LRCC_PREFIX"):
        PREFIX = Path(os.environ["LRCC_PREFIX"]).expanduser().resolve()
        LR = PREFIX / "drive_c/Program Files/Adobe/Adobe Lightroom CC/lightroom.exe"
        CC = PREFIX / "drive_c/Program Files/Adobe/Adobe Creative Cloud/ACC/Creative Cloud.exe"
    if args.command == "doctor": doctor()
    elif args.command == "stage-mangohud": stage_mangohud()
    elif args.command == "measure":
        monitor = next((p for p in (SCRIPT.parent.parent / "diagnostics/monitor.py",
            SCRIPT.parent.parent / "share" / APP / "diagnostics/monitor.py") if p.is_file()), None)
        if monitor is None:
            raise RuntimeError("Performance recorder missing; run make install")
        seconds = args.args[0] if args.args else "30"
        run([sys.executable, monitor, PREFIX, "--seconds", seconds,
             "--output", DATA / "measurements"])
    elif args.command == "status": print(json.dumps(status(), indent=2))
    elif args.command == "fetch": bootstrap()
    elif args.command == "prepare": prepare()
    elif args.command == "initialize-runner":
        env = environment()
        env["WINEDLLOVERRIDES"] = "mscoree,mshtml="
        logged("initialize-runner", lambda log: run([RUNTIME / "bin/wine", "wineboot", "--update"], env=env, stdout=log, stderr=log))
    elif args.command == "repair-vcrun": repair_vcrun()
    elif args.command == "repair-browser": repair_browser()
    elif args.command == "repair-webview": repair_webview()
    elif args.command == "repair-webview-rendering": repair_webview_rendering(args.args[0] if args.args else "software")
    elif args.command == "repair-dxvk": repair_dxvk()
    elif args.command == "repair-growth-sdk": repair_growth_sdk()
    elif args.command == "repair-d3d12": repair_d3d12()
    elif args.command == "repair-performance": repair_performance()
    elif args.command == "stage-webview-148": stage_webview148()
    elif args.command == "stage-proton":
        stage_omarchy() if args.runner == "omarchy" else stage_proton()
    elif args.command == "stage-staging": stage_staging()
    elif args.command == "stage-adobe-browser": stage_adobe_browser()
    elif args.command == "use-installed-webview": select_webview()
    elif args.command == "stage-lightroom": stage_lightroom()
    elif args.command == "experiment-d2d": experiment_d2d()
    elif args.command == "restore-d2d": restore_d2d()
    elif args.command == "experiment-webview":
        profile = args.args[0] if args.args else "software"
        profiles = {"software": "--use-angle=swiftshader", "no-sandbox": "--disable-gpu --no-sandbox",
                    "in-process": "--disable-gpu --disable-gpu-compositing --in-process-gpu"}
        if profile not in profiles:
            raise RuntimeError(f"Unknown WebView2 experiment: {profile}")
        print(f"Experimental WebView2 flags: {profiles[profile]}", flush=True)
        os.environ["WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS"] = profiles[profile]
        launch(LR, f"lightroom-webview-{profile}", [])
    elif args.command == "browser-status": browser_status()
    elif args.command == "capture-webview": run(["node", DATA / "tools/webview-capture.mjs", DATA / "diagnostics"])
    elif args.command == "install-cc": install_cc(args.args[0] if args.args else None)
    elif args.command == "cc": launch(CC, "creative-cloud", ["--disable-gpu", "--disable-gpu-compositing", *args.args])
    elif args.command == "run": launch(LR, "lightroom", args.args)
    elif args.command == "run-perf":
        os.environ["LRCC_PERF"] = "1"
        launch(LR, "lightroom-performance", args.args)
    elif args.command == "run-debug":
        os.environ["LRCC_WINEDEBUG"] = "-all,+seh,+loaddll,warn+d2d,fixme+d2d,err+all"
        launch(LR, "lightroom-debug", args.args)
    elif args.command == "native-debug":
        if PROTON:
            raise RuntimeError("Native debugger currently supports standalone Wine runners only")
        env = environment()
        env["WINELOADERNOEXEC"] = "1"
        os.chdir(LR.parent)
        command = ["gdb", "-nx", "-iex", "set debuginfod enabled off",
                   "-ex", "set pagination off", "-ex", "set print thread-events off",
                   "-ex", "set print frame-arguments none",
                   "-ex", "handle SIGSEGV SIGILL SIGFPE SIGUSR1 SIGUSR2 SIGPIPE nostop noprint pass",
                   "-ex", "run", "--args", str(RUNTIME / "bin/wine"), str(LR)]
        os.execvpe("gdb", command, env)
    elif args.command == "debug": debug(args.args)
    elif args.command == "ui": wine(DATA / "tools/lightroom-ui.exe", *args.args)
    elif args.command == "stop": run([RUNTIME / "bin/wineserver", "-k"], env=environment())
    elif args.command == "integrate": integrate()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError, OSError, lzma.LZMAError, EOFError) as exc:
        print(f"{APP}: {exc}", file=sys.stderr)
        sys.exit(1)
